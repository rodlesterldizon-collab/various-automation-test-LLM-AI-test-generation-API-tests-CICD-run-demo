# ─────────────────────────────────────────────────────────────────────────────
# .env.example — Copy this file to .env and fill in your own values.
# .env is gitignored and must NEVER be committed.
# In CI/CD, all of these are injected as GitHub Actions Secrets.
# ─────────────────────────────────────────────────────────────────────────────

# ReqRes API key — required for API test suite (tests/api/)
# Get a free key at: https://reqres.in/
REQRES_API_KEY=your_reqres_api_key_here

# Groq API key — required for LLM evaluation (tests/api-llm/)
# Get a free key at: https://console.groq.com/
GROQ_API_KEY=gsk_your_groq_key_here

# Google Gemini API key — optional fallback for LLM evaluation
# Get a key at: https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_key_here
